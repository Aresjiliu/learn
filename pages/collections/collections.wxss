.collections-page {
    min-height: 100vh;
    background: var(--color-page-bg);
    padding: 20rpx;
}

.course-list {
    padding: 0 20rpx;
}

.course-item {
    position: relative;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    margin-bottom: 20rpx;
    overflow: hidden;
    box-shadow: var(--shadow-card);
}

.course-cover {
    width: 100%;
    height: 320rpx;
}

.course-info {
    padding: 20rpx;
}

.course-title {
    font-size: 28rpx;
    color: var(--color-text);
    font-weight: bold;
    margin-bottom: 16rpx;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

.course-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.students-count {
    font-size: 24rpx;
    color: var(--color-text-secondary);
}

.price-box {
    display: flex;
    align-items: baseline;
}

.price {
    font-size: 32rpx;
    color: var(--color-primary);
    font-weight: bold;
    margin-right: 12rpx;
}

.original-price {
    font-size: 24rpx;
    color: var(--color-text-secondary);
    text-decoration: line-through;
}

.uncollect-btn {
    position: absolute;
    top: 20rpx;
    right: 20rpx;
    width: 60rpx;
    height: 60rpx;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.uncollect-btn image {
    width: 36rpx;
    height: 36rpx;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 200rpx;
}

.empty-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
}

.empty-text {
    font-size: 28rpx;
    color: var(--color-text-secondary);
    margin-bottom: 40rpx;
}

.go-buy-btn {
    background: var(--color-primary);
    color: var(--color-surface);
    font-size: 28rpx;
    padding: 16rpx 40rpx;
    border-radius: 30rpx;
}
