.page { box-sizing: border-box; min-height: 100vh; padding: 28rpx var(--space-page) 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); background: var(--color-page-bg, #F7F7F5); color: var(--color-text, #242428); font-family: var(--font-family-base, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", Arial, sans-serif); }
.page-title, .page-description, .section-title, .section-description, .section-kicker, .continue-title, .continue-video, .continue-position, .continue-action, .resume-error, .quick-action-title, .quick-action-caption, .content-status, .course-search-input, .clear-search, .search-action, .category-tab, .category-state, .course-title, .course-description, .course-state, .course-price, .demo-cover-title, .demo-cover-label { font-family: var(--font-family-base, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", Arial, sans-serif); }
.home-header { display: flex; flex-direction: column; gap: 12rpx; }
.page-title { color: var(--color-text, #242428); font-size: 40rpx; font-weight: 600; line-height: 1.35; }
.page-description { color: var(--color-text-secondary, #797980); font-size: 26rpx; line-height: 1.6; }
.continue-card { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20rpx; box-sizing: border-box; min-height: 88rpx; margin-top: 28rpx; padding: 28rpx; border: 1rpx solid var(--color-border, #e5e5e2); border-radius: var(--radius-card, 16rpx); background: #ffffff; box-shadow: 0 4rpx 12rpx rgba(36, 36, 40, 0.03); }
.continue-info { flex: 1; min-width: 200rpx; }
.section-kicker { color: var(--color-primary, #b84b45); font-size: 24rpx; font-weight: 500; }
.continue-title { display: block; margin-top: 12rpx; color: var(--color-text, #242428); font-size: 32rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; }
.continue-video { display: block; margin-top: 8rpx; color: var(--color-text-secondary, #797980); font-size: 26rpx; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; }
.continue-position { display: block; margin-top: 16rpx; color: var(--color-text-secondary, #797980); font-size: 24rpx; line-height: 1.5; }
.continue-action { flex-shrink: 0; box-sizing: border-box; min-height: 88rpx; padding: 0 24rpx; border-radius: var(--radius-card, 16rpx); background: var(--color-primary, #b84b45); color: #ffffff; font-size: 26rpx; font-weight: 500; line-height: 88rpx; }
.resume-error { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid var(--color-border, #e5e5e2); border-radius: var(--radius-card, 16rpx); color: var(--color-text-secondary, #797980); background: #ffffff; font-size: 26rpx; line-height: 1.6; overflow-wrap: anywhere; }
.quick-actions { display: flex; gap: 12rpx; margin-top: 24rpx; padding: 12rpx 4rpx; border-radius: var(--radius-card, 16rpx); background: #ffffff; }
.quick-action { display: flex; flex: 1; min-width: 0; min-height: 88rpx; flex-direction: column; align-items: center; box-sizing: border-box; padding: 20rpx 4rpx; }
.quick-action-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-bottom: 12rpx; border-radius: var(--radius-card, 16rpx); background: var(--color-primary-soft, #fff2f1); color: var(--color-primary, #b84b45); }
.quick-action-title { color: var(--color-text, #242428); font-size: 28rpx; font-weight: 500; line-height: 1.5; text-align: center; }
.quick-action-caption { margin-top: 8rpx; color: var(--color-text-secondary, #797980); font-size: 22rpx; line-height: 1.5; text-align: center; }
.section-heading { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12rpx; margin-top: 36rpx; }
.section-title { display: block; color: var(--color-text, #242428); font-size: 32rpx; font-weight: 600; }
.section-description { display: block; margin-top: 8rpx; color: var(--color-text-secondary, #797980); font-size: 24rpx; line-height: 1.6; }
.content-status { flex-shrink: 0; max-width: 240rpx; padding-top: 4rpx; color: var(--color-text-secondary, #797980); font-size: 22rpx; line-height: 1.6; }
.search-card { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; margin-top: 20rpx; }
.search-box { display: flex; flex: 1; align-items: center; gap: 12rpx; min-width: 0; min-height: 88rpx; padding: 0 16rpx; border: 1rpx solid var(--color-border, #e5e5e2); border-radius: var(--radius-card, 16rpx); background: #ffffff; }
.course-search-input { flex: 1; min-width: 0; height: 88rpx; color: var(--color-text, #242428); font-size: 28rpx; }
.placeholder { color: var(--color-text-secondary, #797980); }
.clear-search { flex-shrink: 0; width: 88rpx; height: 88rpx; margin: 0 -12rpx 0 0; padding: 0; border-radius: 0; color: var(--color-text-secondary, #797980); background: transparent; font-size: 24rpx; line-height: 88rpx; }
.search-action { flex-shrink: 0; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border-radius: 0; color: var(--color-primary, #b84b45); background: transparent; font-size: 28rpx; line-height: 88rpx; }
.clear-search::after, .search-action::after, .category-state::after, .course-state-card::after { border: 0; }
.category-scroll { width: 100%; margin-top: 16rpx; }
.category-tabs { display: inline-flex; gap: 12rpx; white-space: nowrap; }
.category-tab { display: inline-block; box-sizing: border-box; min-height: 88rpx; padding: 22rpx 20rpx; border: 1rpx solid transparent; border-radius: var(--radius-card, 16rpx); color: var(--color-text-secondary, #797980); background: transparent; font-size: 24rpx; line-height: 42rpx; }
.category-tab.active { color: var(--color-primary, #b84b45); background: var(--color-primary-soft, #fff2f1); }
.category-state { box-sizing: border-box; width: 100%; min-height: 88rpx; margin-top: 16rpx; padding: 20rpx; border-radius: var(--radius-card, 16rpx); color: var(--color-text-secondary, #797980); background: #ffffff; font-size: 26rpx; line-height: 1.6; text-align: left; }
.course-list { margin-top: 16rpx; padding: 0 20rpx; border: 1rpx solid var(--color-border, #e5e5e2); border-radius: var(--radius-card, 16rpx); background: #ffffff; }
.course-card { display: flex; gap: 20rpx; box-sizing: border-box; min-height: 88rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border, #e5e5e2); background: #ffffff; }
.course-card:last-child { border-bottom: 0; }
.course-cover-wrap { position: relative; flex-shrink: 0; width: 144rpx; height: 180rpx; overflow: hidden; border: 1rpx solid var(--color-border, #e5e5e2); border-radius: 10rpx; background: #f2f1ed; }
.course-cover { display: block; width: 100%; height: 100%; }
.course-demo-cover { display: flex; box-sizing: border-box; width: 100%; height: 100%; padding: 16rpx 12rpx; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; background: #f2f1ed; }
.demo-cover-title { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; max-width: 100%; color: var(--color-text, #242428); font-size: 24rpx; line-height: 1.4; text-align: center; word-break: break-all; }
.demo-cover-label { color: var(--color-text-secondary, #797980); font-size: 20rpx; line-height: 1.4; }
.course-info { flex: 1; min-width: 0; padding: 4rpx 0; }
.course-heading { display: flex; min-width: 0; }
.course-title { min-width: 0; color: var(--color-text, #242428); font-size: 30rpx; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; }
.course-description { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 10rpx; color: var(--color-text-secondary, #797980); font-size: 24rpx; line-height: 1.6; }
.course-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx 16rpx; margin-top: 16rpx; }
.course-state { color: var(--color-text-secondary, #797980); font-size: 22rpx; }
.course-price { color: var(--color-text, #242428); font-size: 26rpx; font-weight: 500; }
.course-price.free { color: var(--color-text-secondary, #797980); }
.course-state-card { box-sizing: border-box; width: 100%; min-height: 88rpx; margin-top: 20rpx; padding: 32rpx 16rpx; border: 1rpx solid var(--color-border, #e5e5e2); border-radius: var(--radius-card, 16rpx); color: var(--color-text-secondary, #797980); background: #ffffff; font-size: 26rpx; line-height: 1.6; text-align: center; }
.course-state.error { color: var(--color-text-secondary, #797980); }
