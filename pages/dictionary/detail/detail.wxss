page { background: #ffffff; color: #111111; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { min-height: 100vh; padding: 24rpx 32rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #ffffff; color: #111111; font-size: 30rpx; line-height: 1.65; }
.word-head { padding-bottom: 22rpx; border-bottom: 1rpx solid #eeeeee; }
.word-identity { min-width: 0; }
.word { display: block; max-width: 100%; color: #111111; font-size: 52rpx; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; word-break: break-word; }
.word-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 8rpx; }
.word-metadata { display: flex; flex: 1; min-width: 0; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; }
.part, .source, .audio-source, .pronunciation-hint, .audio-pending, .audio-unavailable { color: #666666; font-size: 24rpx; overflow-wrap: anywhere; }
.audio-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; box-sizing: border-box; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 1rpx solid #eeeeee; border-radius: 50%; color: #ed625c; background: #ffffff; }
.audio-button::after, .audio-retry::after, .state-action::after { border: 0; }
.audio-button--playing { border-color: #ed625c; background: #fff2f1; }
.audio-error { margin-top: 12rpx; color: #ed625c; font-size: 26rpx; }
.audio-retry { min-height: 88rpx; margin: 8rpx 0 0; padding: 0 20rpx; color: #ed625c; background: #fff2f1; font-size: 26rpx; line-height: 88rpx; }
.audio-pending, .audio-unavailable, .pronunciation-hint { display: block; margin-top: 8rpx; }
.word-section { margin-top: 26rpx; }
.section-label { display: block; margin-bottom: 12rpx; color: #ed625c; font-size: 26rpx; font-weight: 500; }
.meaning, .example { display: block; color: #111111; font-size: 30rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.example + .example { margin-top: 16rpx; }
.state-card { padding: 40rpx 0; text-align: center; }
.empty-state { color: #666666; }
.error-state { color: #111111; }
.state-action { min-height: 88rpx; margin-top: 20rpx; color: #ed625c; background: #fff2f1; font-size: 30rpx; }
