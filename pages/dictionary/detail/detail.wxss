.page { min-height: 100vh; padding: var(--space-page); box-sizing: border-box; background: var(--color-page-bg); }
.detail-card, .state-card { border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-card); }
.detail-card { padding: 30rpx; }
.word-head { padding-bottom: 28rpx; border-bottom: 2rpx solid #eef0f3; }
.word-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.word-identity { flex: 1; min-width: 0; }
.word { display: block; max-width: 100%; color: var(--color-text); font-size: 56rpx; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
.source { display: inline-block; margin-top: 14rpx; padding: 5rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; }
.textbook-source { color: var(--color-primary); background: var(--color-sky); }
.dictionary-source { color: var(--color-exam); background: #fff7ed; }
.audio-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; box-sizing: border-box; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 2rpx solid var(--color-sky); border-radius: 50%; color: var(--color-primary); background: var(--color-sky); }
.audio-button::after { border: 0; }
.audio-button--playing { border-color: var(--color-primary); background: var(--color-sky); }
.speaker-icon { position: relative; width: 42rpx; height: 42rpx; color: var(--color-primary); }
.speaker-icon__body { position: absolute; top: 14rpx; left: 2rpx; width: 10rpx; height: 14rpx; border-radius: 2rpx; background: currentColor; }
.speaker-icon__cone { position: absolute; top: 4rpx; left: 8rpx; width: 0; height: 0; border-top: 17rpx solid transparent; border-right: 20rpx solid currentColor; border-bottom: 17rpx solid transparent; }
.speaker-icon__wave { position: absolute; top: 5rpx; right: 0; width: 18rpx; height: 32rpx; border: 3rpx solid currentColor; border-top-color: transparent; border-bottom-color: transparent; border-left-color: transparent; border-radius: 50%; }
.word-metadata { display: flex; flex-wrap: wrap; align-items: center; column-gap: 16rpx; row-gap: 8rpx; }
.word-metadata:not(:empty) { margin-top: 18rpx; }
.audio-source, .pronunciation-hint { color: var(--color-text-secondary); font-size: var(--font-size-caption); line-height: 1.6; }
.audio-error { margin-top: 16rpx; color: var(--color-error); font-size: var(--font-size-caption); line-height: 1.5; }
.audio-retry { min-height: 88rpx; margin: 8rpx 0 0; padding: 0 22rpx; color: var(--color-primary); background: var(--color-sky); font-size: var(--font-size-caption); line-height: 88rpx; }
.audio-pending, .audio-unavailable { display: block; margin-top: 16rpx; color: var(--color-text-secondary); font-size: var(--font-size-caption); }
.word-section { margin-top: 30rpx; }
.section-label { display: block; color: var(--color-text-secondary); font-size: var(--font-size-caption); font-weight: 600; letter-spacing: 2rpx; }
.part { display: block; margin-top: 10rpx; color: var(--color-text); font-size: var(--font-size-body); line-height: 1.5; }
.meaning { display: block; margin-top: 12rpx; color: var(--color-text); font-size: 32rpx; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.example { display: block; margin-top: 14rpx; padding: 16rpx; border-left: 4rpx solid var(--color-primary); border-radius: 0 10rpx 10rpx 0; color: var(--color-text-secondary); background: #f7f9fb; font-size: var(--font-size-body); line-height: 1.7; overflow-wrap: anywhere; }
.state-card { margin-top: 20rpx; padding: 34rpx 24rpx; text-align: center; line-height: 1.6; }
.loading-state { color: var(--color-loading); }
.empty-state { color: var(--color-empty); }
.state-action { min-height: 88rpx; margin-top: 20rpx; color: var(--color-primary); background: var(--color-sky); }
