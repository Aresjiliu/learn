page { background: #ffffff; color: #111111; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", Arial, sans-serif; }
.page, .audio-button, .audio-retry, .state-action, .section-toggle, .metadata-toggle, .meaning, .example, .word, .part, .metadata-value, .source { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", Arial, sans-serif; }
.page { min-height: 100vh; padding: 24rpx 32rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #ffffff; color: #111111; font-size: 30rpx; line-height: 1.65; }
.word-head { padding-bottom: 22rpx; border-bottom: 1rpx solid #eeeeee; }
.word-identity { min-width: 0; }
.word { display: block; max-width: 100%; color: #111111; font-size: 52rpx; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; word-break: break-word; }
.word-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 8rpx; }
.word-metadata { display: flex; flex: 1; min-width: 0; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; }
.part, .source, .audio-source, .pronunciation-hint, .audio-pending, .audio-unavailable { color: #666666; font-size: 24rpx; overflow-wrap: anywhere; }
.part { padding: 2rpx 12rpx; border: 1rpx solid #e5e7eb; border-radius: 8rpx; background: #f7f8fa; color: #4c5058; }
.pronunciation-label { color: #85858c; font-size: 24rpx; }
.audio-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; box-sizing: border-box; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 1rpx solid #eeeeee; border-radius: 50%; color: #ed625c; background: #ffffff; }
.audio-button::after, .audio-retry::after, .state-action::after { border: 0; }
.audio-button--playing { border-color: #ed625c; background: #fff2f1; }
.audio-error { margin-top: 12rpx; color: #ed625c; font-size: 26rpx; }
.audio-retry { min-height: 88rpx; margin: 8rpx 0 0; padding: 0 20rpx; color: #ed625c; background: #fff2f1; font-size: 26rpx; line-height: 88rpx; }
.audio-pending, .audio-unavailable, .pronunciation-hint { display: block; margin-top: 8rpx; }
.word-section { margin-top: 26rpx; }
.section-label { display: block; margin-bottom: 16rpx; padding-left: 16rpx; border-left: 5rpx solid #ed625c; color: #242428; font-size: 28rpx; font-weight: 600; line-height: 1.2; }
.meaning-panel { padding: 24rpx; border: 1rpx solid #e5e7eb; border-radius: 12rpx; background: #fafbfc; }
.examples-panel { border: 1rpx solid #e5e7eb; border-radius: 12rpx; overflow: hidden; }
.meaning, .example { display: block; color: #111111; font-size: 30rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.example { padding: 24rpx; }
.example + .example { border-top: 1rpx solid #e5e7eb; }
.section-toggle { min-height: 88rpx; margin: 8rpx 0 0; padding: 0; color: #c74e49; background: transparent; font-size: 26rpx; line-height: 88rpx; text-align: left; }
.section-toggle::after, .metadata-toggle::after { border: 0; }
.metadata-section { border: 1rpx solid #e5e7eb; border-radius: 12rpx; overflow: hidden; }
.metadata-toggle { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 0; color: #242428; background: #ffffff; text-align: left; }
.metadata-title { font-size: 28rpx; font-weight: 500; }
.metadata-toggle-label { flex-shrink: 0; color: #797980; font-size: 24rpx; }
.metadata-panel { border-top: 1rpx solid #e5e7eb; padding: 8rpx 24rpx; background: #fafbfc; }
.metadata-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 16rpx 0; }
.metadata-row + .metadata-row { border-top: 1rpx solid #ececee; }
.metadata-label { flex-shrink: 0; color: #85858c; font-size: 24rpx; }
.metadata-value { min-width: 0; color: #4c5058; font-size: 24rpx; overflow-wrap: anywhere; }
.audio-metadata { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; }
.state-card { padding: 40rpx 0; text-align: center; }
.empty-state { color: #666666; }
.error-state { color: #111111; }
.state-action { min-height: 88rpx; margin-top: 20rpx; color: #ed625c; background: #fff2f1; font-size: 30rpx; }
.source-notice { margin-bottom: 22rpx; padding: 16rpx 24rpx; border: 1rpx solid #e5e7eb; border-radius: 12rpx; background: #fafbfc; color: #666666; font-size: 26rpx; }
.source-requery { min-height: 88rpx; margin: 0; padding: 0; color: #c74e49; background: transparent; font-family: inherit; font-size: 26rpx; line-height: 88rpx; text-align: left; }
.source-requery::after { border: 0; }
.wordbook-link { min-height: 88rpx; margin: 0; padding: 0; border-radius: 0; background: transparent; color: var(--color-primary, #b84b45); font-size: 26rpx; line-height: 88rpx; text-align: left; }
.wordbook-link::after { border: 0; }
