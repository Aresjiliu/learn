page { background: #fff; color: #171719; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { min-height: 100vh; box-sizing: border-box; padding: 20rpx 32rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: #fff; }
button { margin: 0; padding: 0; border-radius: 0; font-weight: 400; }
button::after { border: 0; }
.search-bar { position: relative; display: flex; align-items: center; gap: 16rpx; --search-padding: 0; --search-background-color: #f5f5f7; --padding-sm: 0; --cell-line-height: calc(88rpx - 10px); --cell-font-size: 30rpx; --field-input-text-color: #171719; }
.search-control { display: block; flex: 1; min-width: 0; }
/* Vant Search 1.11.7 supplies 5px vertical Field padding on each side. */
.dictionary-search-input { padding: 0 88rpx 0 88rpx; color: #171719; font-size: 30rpx; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.icon-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: #68686e; background: transparent; line-height: 1; }
.search-icon { position: absolute; left: 0; top: 0; color: #171719; }
.clear-button { position: absolute; right: 104rpx; top: 0; width: 88rpx; }
.search-action { flex-shrink: 0; width: 88rpx; height: 88rpx; color: #ed625c; background: transparent; font-size: 28rpx; line-height: 88rpx; }
.discovery { margin-top: 24rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; color: #77777d; font-size: 26rpx; }
.section-heading .icon-button { margin-right: -20rpx; }
.history-list { display: flex; flex-wrap: wrap; gap: 4rpx 20rpx; }
.history-item { display: flex; align-items: center; max-width: 100%; min-height: 88rpx; }
.history-query { min-width: 0; color: #27272a; font-size: 28rpx; line-height: 1.5; overflow-wrap: anywhere; }
.history-remove { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: #77777d; background: transparent; }
.history-empty { display: block; padding: 12rpx 0 24rpx; color: #77777d; font-size: 26rpx; }
.examples { margin-top: 28rpx; padding-top: 12rpx; border-top: 1rpx solid #ececee; }
.example-list { display: flex; flex-wrap: wrap; gap: 8rpx 40rpx; }
.example-query { min-height: 88rpx; color: #27272a; background: transparent; font-size: 30rpx; line-height: 88rpx; }
.example-help { display: block; margin-top: 12rpx; color: #77777d; font-size: 24rpx; line-height: 1.6; }
.notice { display: block; margin-top: 20rpx; color: #975b36; font-size: 24rpx; line-height: 1.6; }
.results-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-top: 32rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid #ececee; font-size: 24rpx; }
.result-query { min-width: 0; color: #27272a; overflow-wrap: anywhere; }
.result-count { flex-shrink: 0; color: #77777d; }
.state { padding: 64rpx 0; color: #77777d; text-align: center; font-size: 26rpx; line-height: 1.7; }
.error-state { color: #a74d47; }
.state-action, .load-more { min-height: 88rpx; margin-top: 20rpx; background: #fff; color: #ed625c; font-size: 28rpx; line-height: 88rpx; }
.empty-title { display: block; margin-bottom: 12rpx; color: #27272a; font-size: 30rpx; }
