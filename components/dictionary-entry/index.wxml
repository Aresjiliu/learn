<view class="entry" bindtap="open" role="button" aria-label="查看{{entry.headword}}的释义" hover-class="entry--pressed">
    <view class="entry__heading">
        <text class="entry__headword">{{entry.headword}}</text>
        <text wx:if="{{entry.shortWordClass}}" class="entry__class">{{entry.shortWordClass}}</text>
    </view>
    <view class="entry__summary">
        <text user-select="{{true}}">{{entry.summary || '释义待补充'}}</text>
    </view>
    <text wx:if="{{entry.matchTier === 'wordForm'}}" class="entry__match">{{entry.matchLabel}}</text>
</view>
