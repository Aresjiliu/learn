.wordbook-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12rpx;
    padding: 12rpx 0;
    background: var(--color-surface, #ffffff);
}

.wordbook-action__button,
.wordbook-action__retry {
    margin: 0;
    min-height: 88rpx;
    padding: 0 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    line-height: 1.4;
    color: var(--color-primary, #b84b45);
    background: var(--color-surface, #ffffff);
    border: 2rpx solid var(--color-primary, #b84b45);
    border-radius: var(--radius-card, 16rpx);
}

.wordbook-action__button::after,
.wordbook-action__retry::after {
    border: none;
}

.wordbook-action__button--disabled {
    color: var(--color-text-secondary, #67676f);
    border-color: var(--color-border, #e6e6e3);
    background: var(--color-surface, #ffffff);
}

.wordbook-action__status {
    display: flex;
    flex-direction: column;
}

.wordbook-action__status-text,
.wordbook-action__local {
    font-size: 24rpx;
    color: var(--color-text-secondary, #67676f);
}

.wordbook-action__local {
    margin-top: 4rpx;
}

.wordbook-action__error {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12rpx;
    font-size: 24rpx;
    color: var(--color-error, #c2413b);
}
