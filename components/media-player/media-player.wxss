.media-player {
    width: 100%;
    height: 100%;
}

.media-player__surface {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: #fff;
    font-size: 26rpx;
}

.media-player__chrome {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* One 44px row with 4px vertical padding; time and track share the center target. */
.media-player__bottom {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    box-sizing: border-box;
    height: 52px;
    padding: 4px 0;
}

.media-player__bar-backdrop {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 52px;
    background-color: rgba(0, 0, 0, 0.28);
}

.media-player__track-hit {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    box-sizing: border-box;
    min-width: 0;
    height: 44px;
    padding: 0 8px;
}

.media-player__track {
    position: relative;
    width: 100%;
    height: 22rpx;
}

.media-player__rail {
    position: absolute;
    top: 9rpx;
    right: 0;
    left: 0;
    height: 4rpx;
    border-radius: 2rpx;
    background-color: rgba(255, 255, 255, 0.32);
}

.media-player__fill {
    position: relative;
    min-width: 22rpx;
    height: 22rpx;
}

.media-player__fill-line {
    position: absolute;
    top: 9rpx;
    right: 0;
    left: 0;
    height: 4rpx;
    border-radius: 2rpx;
    background-color: #fff;
}

.media-player__thumb {
    position: absolute;
    top: 0;
    right: 0;
    width: 22rpx;
    height: 22rpx;
    border-radius: 50%;
    background-color: #fff;
}

.media-player__row {
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 44px;
    padding: 0 4px;
}

.media-player__time {
    width: 100%;
    margin-bottom: 3px;
    font-size: 10px;
    line-height: 16px;
    white-space: nowrap;
}

.media-player__button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    font-size: 13px;
    line-height: 44px;
    text-align: center;
}

.media-player__wide {
    display: none;
    align-items: center;
}

.media-player__disabled {
    opacity: 0.42;
}

.media-player__play {
    width: 0;
    height: 0;
    margin-left: 3px;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 12px solid #fff;
}

.media-player__pause {
    width: 6px;
    height: 15px;
    border-left: 3px solid #fff;
    border-right: 3px solid #fff;
}

.media-player__settings {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 18px;
    height: 16px;
}

.media-player__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: #fff;
}

.media-player__fullscreen-icon {
    position: relative;
    width: 18px;
    height: 16px;
}

.media-player__corner {
    position: absolute;
    width: 5px;
    height: 5px;
    border-color: #fff;
    border-style: solid;
}

.media-player__corner--tl {
    top: 0;
    left: 0;
    border-width: 1.5px 0 0 1.5px;
}

.media-player__corner--tr {
    top: 0;
    right: 0;
    border-width: 1.5px 1.5px 0 0;
}

.media-player__corner--bl {
    bottom: 0;
    left: 0;
    border-width: 0 0 1.5px 1.5px;
}

.media-player__corner--br {
    bottom: 0;
    right: 0;
    border-width: 0 1.5px 1.5px 0;
}

.media-player__fullscreen-icon--exit .media-player__corner--tl {
    border-width: 0 1.5px 1.5px 0;
}

.media-player__fullscreen-icon--exit .media-player__corner--tr {
    border-width: 0 0 1.5px 1.5px;
}

.media-player__fullscreen-icon--exit .media-player__corner--bl {
    border-width: 1.5px 1.5px 0 0;
}

.media-player__fullscreen-icon--exit .media-player__corner--br {
    border-width: 1.5px 0 0 1.5px;
}

.media-player__panel {
    position: absolute;
    right: 8px;
    bottom: 60px;
    box-sizing: border-box;
    width: 244px;
    max-width: calc(100% - 16px);
    padding: 4px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.72);
}

.media-player__rate-list,
.media-player__options {
    display: flex;
    align-items: center;
}

.media-player__rate,
.media-player__option {
    flex: 1;
    min-width: 44px;
    min-height: 44px;
    font-size: 13px;
    line-height: 44px;
    text-align: center;
    border-radius: 5px;
}

.media-player__rate--active,
.media-player__option--active {
    background-color: rgba(255, 255, 255, 0.18);
}

.media-player__message {
    position: absolute;
    top: 8px;
    right: 8px;
    left: 8px;
    padding: 4px 8px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.64);
    font-size: 12px;
    line-height: 18px;
    white-space: normal;
}

.media-player__surface--fullscreen .media-player__bottom {
    bottom: env(safe-area-inset-bottom);
}

.media-player__surface--fullscreen .media-player__row {
    padding-right: calc(8px + env(safe-area-inset-right));
    padding-left: calc(8px + env(safe-area-inset-left));
}

.media-player__surface--fullscreen .media-player__panel {
    right: calc(8px + env(safe-area-inset-right));
    bottom: calc(60px + env(safe-area-inset-bottom));
}

@media (min-width: 600px) {
    .media-player__wide {
        display: flex;
    }

    .media-player__time {
        font-size: 12px;
    }

    .media-player__track,
    .media-player__fill,
    .media-player__thumb {
        height: 11px;
    }

    .media-player__fill {
        min-width: 11px;
    }

    .media-player__thumb {
        width: 11px;
    }

    .media-player__rail,
    .media-player__fill-line {
        top: 4.5px;
        height: 2px;
    }
}
