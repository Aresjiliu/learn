<video wx:if="{{src}}"
    id="mediaVideo"
    class="media-player"
    src="{{src}}"
    title="{{title}}"
    autoplay="{{autoplay}}"
    controls="{{controls}}"
    show-center-play-btn="{{true}}"
    enable-play-gesture="{{true}}"
    enable-progress-gesture="{{true}}"
    initial-time="{{initialTime}}"
    bindtimeupdate="onTimeUpdate"
    bindended="onEnded"
    bindplay="onPlay"
    bindpause="onPause"
    bindwaiting="onWaiting"
    binderror="onError"
    bindfullscreenchange="onFullscreenChange"
    bindplaybackratechange="onPlaybackRateChange"
    bindprogress="onProgress"
    bindseek="onSeek"
    bindseekcomplete="onSeekComplete"
    play-btn-position="center"
    show-mute-btn="{{true}}"
    show-play-btn="{{true}}"
    show-progress="{{true}}"
    object-fit="{{objectFit}}"
    buffer="{{2}}"
    cache="{{true}}"
    custom-cache="{{false}}">
</video>
